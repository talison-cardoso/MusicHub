---
import { MusicCatalog } from '@/components/MusicCatalog';
import Layout from '@/layouts/Layout.astro';
import { SoundWave } from '@/components/SoundWave';
// import { SoundWavePlayer } from '@/components/SoundWave';
---

<Layout>
  <div class="relative w-full overflow-hidden pt-36 pb-10">
    <!-- Top Ambient Accent -->
    <div
      class="absolute -top-36 left-1/2 -translate-x-1/2 w-96 h-96 bg-primary-container/15 rounded-full blur-[128px] pointer-events-none"
    >
    </div>
    <!-- Hero Card Profile & High-Value Metrics (Redesign of Top Section) -->
    <section
      class="w-full bg-surface-container rounded-xl p-6 lg:p-10 shadow-xl relative overflow-hidden mb-8"
    >
      <!-- Subtle top subtle sheen -->
      <div
        class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary/30 to-transparent"
      >
      </div>
      <div
        class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between"
      >
        
      <!-- Artist Identity Column -->
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center gap-6"
        >
          <div class="relative group">
            <div
              class="w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden shadow-2xl relative bg-surface-container-lowest p-1"
            >
              <img
                class="w-full h-full object-cover rounded-full group-hover:scale-105 transition-transform duration-500"
                data-alt="Editorial portrait album artwork cover of hip-hop and trap music artist Young Nisioo, moody cinematic dark blue neon lights with heartbeat waveform pulse graphic and gothic lettering titled Crushes And Lovers EP, 8k resolution, minimalist album sleeve aesthetic"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmBIkZLC9Sx0ZjQpI9NYZgXWfycJ9ehR7vJvvblbpS1DTrhE9WUzp0nvpWZK3RsEi6HHpgaCaLDyznnmMmzpGR322kzh7_GPexea0NPYsZnbQOFstpfJQU2bSuFQNQK-_24yY2yggDcpfE-4jSYYcbU-8spkHDS3OSHXNWCw2iN98wA83UnxBHm0i93erP9Q_0UANwTe0bq8QUtdA_Ji9UZM6tZU97epk9pryyt_zKhJYS_T8YvSZ0"
              />
            </div>
            <div
              class="absolute bottom-1 right-1 size-6 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-md "
            >
              <span
                class="material-symbols-outlined text-[8px]"
                style="font-variation-settings: 'FILL' 1;">verified</span
              >
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="font-display-hero text-headline-lg lg:text-headline-lg text-on-surface tracking-tight"
              >
                Young Nisioo
              </span>
              <span
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary font-label-md text-label-md tracking-wide"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
                ></span>
                Rapper &amp; Compositor
              </span>
            </div>
            <p
              class="font-body-md text-body-md text-on-surface-variant max-w-md"
            >
              Música independente com identidade lírica crua, fusão melódica de
              R&amp;B contemporâneo e trap conceitual.
            </p>
            <div class="flex items-center gap-3 pt-2">
              <a
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary-container font-label-lg text-label-lg hover:bg-secondary-container transition-all duration-200 shadow-md"
                data-path="musicas"
                href="#"
              >
                <span class="material-symbols-outlined text-[18px]"
                  >play_circle</span
                >
                Ouvir Lançamentos
              </a>
            </div>
          </div>
        </div>
        <!-- Metric Cards Bento Grid (Matching image's +59 Músicas, +6 EPs, +99 Ouvintes) -->
        <div class="grid grid-cols-3 sm:grid-cols-3 gap-3 w-full lg:w-auto">
          <div
            class="flex flex-col items-center justify-center p-4 sm:p-5 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-all duration-300 text-center shadow-md min-w-25 sm:min-w-30"
          >
            <span
              class="font-stat-counter text-stat-counter text-secondary tracking-tight"
            >
              +59
            </span>
            <span
              class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mt-1"
            >
              Músicas
            </span>
          </div>
          <div
            class="flex flex-col items-center justify-center p-4 sm:p-5 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-all duration-300 text-center shadow-md min-w-25 sm:min-w-30"
          >
            <span
              class="font-stat-counter text-stat-counter text-secondary tracking-tight"
            >
              +6
            </span>
            <span
              class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mt-1"
            >
              EPs
            </span>
          </div>
          <div
            class="flex flex-col items-center justify-center p-4 sm:p-5 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-all duration-300 text-center shadow-md min-w-25 sm:min-w-30"
          >
            <span
              class="font-stat-counter text-stat-counter text-secondary tracking-tight"
            >
              +99K
            </span>
            <span
              class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mt-1"
            >
              Ouvintes
            </span>
          </div>
        </div>
      </div>


    </section>
    <!-- Main Content Dual-Column Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Editorial Column: "Sobre o Artista" (From Reference Screen) -->
      <section
        class="lg:col-span-7 flex flex-col gap-6 bg-surface-container rounded-xl p-8 lg:p-10 shadow-xl relative"
      >
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-[24px]"
              >info</span
            >
            <h2
              class="font-headline-lg text-headline-lg text-on-surface tracking-tight"
            >
              Sobre o Artista
            </h2>
          </div>
          <span
            class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant bg-surface-container-low px-3 py-1 rounded-full"
          >
            Manifesto
          </span>
        </div>
        <!-- Pull quote banner for high-end hip hop editorial feeling -->
        <blockquote
          class="p-4 rounded-lg bg-surface-container-low text-primary font-headline-sm text-headline-sm italic"
        >
          “Mais do que um site de downloads, este é um ponto de encontro entre o
          artista e os seus ouvintes.”
        </blockquote>
        <div
          class="flex flex-col gap-4 font-body-lg text-body-lg text-on-surface-variant leading-relaxed"
        >
          <p>
            Bem-vindo ao espaço oficial de música do rapper e compositor <strong
              class="text-on-surface font-semibold">Young Nisioo</strong
            >, plataforma criada especialmente para aproximar o artista dos seus
            ouvintes e tornar a sua música acessível a todos.
          </p>
          <p>
            Aqui poderás encontrar e fazer download das músicas mais recentes e
            dos projectos já lançados, tudo organizado de forma simples, rápida
            e segura. Cada lançamento é disponibilizado directamente pelo
            artista, garantindo autenticidade e qualidade cristalina.
          </p>
          <p>
            Para além de fazeres download das faixas, esta plataforma permite
            que conheças as redes sociais do Young Nisioo, acompanhes as
            novidades em primeira mão, fiques por dentro dos próximos
            lançamentos e estejas sempre conectado à sua jornada artística.
          </p>
        </div>
        <div
          class="pt-4 flex flex-wrap items-center justify-between gap-4 bg-surface-container-low p-5 rounded-lg"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-[20px]"
                >equalizer</span
              >
            </div>
            <div>
              <p class="font-label-lg text-label-lg text-on-surface">
                Explora. Baixa. Partilha.
              </p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">
                Faz parte do movimento cultural Young Nisioo.
              </p>
            </div>
          </div>
          <a
            class="inline-flex items-center gap-1.5 text-primary hover:text-on-surface font-label-lg text-label-lg transition-colors"
            data-path="redes-sociais"
            href="#"
          >
            Ver todas as redes
            <span class="material-symbols-outlined text-[16px]"
              >arrow_forward</span
            >
          </a>
        </div>
      </section>
      <!-- Right Column: Featured Release Spotlight & Interactive Preview -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Featured Release Card -->
        <section
          class="bg-surface-container rounded-xl p-6 lg:p-7 shadow-xl flex flex-col gap-5 relative overflow-hidden"
        >
          <div class="flex items-center justify-between">
            <span
              class="font-label-md text-label-md text-tertiary uppercase tracking-widest flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-tertiary"></span>
              Lançamento em Destaque
            </span>
            <span class="font-label-md text-label-md text-on-surface-variant"
              >EP Oficial</span
            >
          </div>
          <!-- Album Art with Play Overlay -->
          <div
            class="relative w-full aspect-square rounded-lg overflow-hidden bg-surface-container-low group shadow-lg"
          >
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              data-alt="Modern dark rap music album cover with typography Crushes And Lovers EP by Young Nisioo, artistic monochromatic heart beat line glowing in cyan and deep electric blue, minimal moody urban style, studio cover photograph"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAwgfyNfTljKm6ls8Bc6bKNtn0yOV8dYfbtZDE-nuRjc5hFa7pkXV2dcz_zmfOn_e5J7BgyvHndhJiZiJn1cHOkthtsA_p-9tKOebbk0PBxKLBu_bfdPOtJYmkQdPd7sFs_6sb6dMCFtoNfJunaIx29KL8lgEjmNefNCcIrnDb_YsRRowjN98Mb-nu3HeDtOHMllqnjTvyK-1DtkO6ykVwjJ2p-we8NSAJ16xtiCMo9nCLDz5SYZG5G"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 right-4 flex items-end justify-between"
            >
              <div>
                <span
                  class="font-label-md text-label-md text-secondary-fixed-dim"
                  >Young Nisioo</span
                >
                <h3
                  class="font-headline-lg text-headline-lg text-on-surface tracking-tight leading-none"
                >
                  Crushes And Lovers
                </h3>
              </div>
              <button
                aria-label="Reproduzir prévia de Crushes And Lovers"
                class="w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all"
                id="play-featured-btn"
              >
                <span
                  class="material-symbols-outlined text-[28px]"
                  id="play-icon"
                  style="font-variation-settings: 'FILL' 1;">play_arrow</span
                >
              </button>
            </div>
          </div>
          <!-- Track Info / Soundwave Preview Strip -->
          <div
            class="flex flex-col gap-3 bg-surface-container-low p-4 rounded-lg"
          >
            <div
              class="flex items-center justify-between font-label-md text-label-md"
            >
              <span class="text-on-surface">Faixa 01 • Intro (Pre-Save)</span>
              <span class="text-on-surface-variant" id="track-time">02:44</span>
            </div>
            <!-- XXX Dynamic Soundwave SVG Visualization -->
            <div
              class="w-full h-8 flex items-center justify-between gap-1 cursor-pointer"
              id="soundwave-bar"
            >
            <SoundWave isPlaying={true} barCount={20} />
            </div>
            <!-- Action Buttons for Download / Stream -->
            <div class="grid grid-cols-2 gap-3 pt-2">
              <a
                class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-full bg-primary-container text-on-primary-container font-label-lg text-label-lg hover:bg-secondary-container transition-colors shadow-sm"
                data-path="ouvir-agora"
                href="#"
              >
                <span class="material-symbols-outlined text-[18px]"
                  >download</span
                >
                Download MP3
              </a>
              <a
                class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-full bg-surface-container-high text-on-surface font-label-lg text-label-lg hover:bg-surface-bright transition-colors shadow-sm"
                data-path="musicas"
                href="#"
              >
                <span class="material-symbols-outlined text-[18px]"
                  >library_music</span
                >
                Ver Tracklist
              </a>
            </div>
          </div>
        </section>

        </div>
    </div>

    <!-- XXX Musicas Recentes para donwload -->
    <section class="w-full flex flex-col gap-6 pt-4">
      <!-- <MusicCatalog /> -->
    </section>
  </div>

  <script>
    (function () {
  const playBtn = document.getElementById('play-featured-btn');
  const playIcon = document.getElementById('play-icon');
  const soundwave = document.getElementById('soundwave-bar');

  let isPlaying = false;
   let intervalId: ReturnType<typeof setInterval> | null = null;



  if (playBtn && playIcon && soundwave) {
    const bars = soundwave.querySelectorAll('span');

    playBtn.addEventListener('click', function (e) {
      e.preventDefault();
      isPlaying = !isPlaying;

      if (isPlaying) {
        playIcon.textContent = 'pause';

        intervalId = setInterval(() => {
          bars.forEach((bar) => {
            const randomH = Math.floor(Math.random() * 26) + 8;
            bar.style.height = randomH + 'px';
          });
        }, 150);
      } else {
        playIcon.textContent = 'play_arrow';

        if (intervalId !== null) {
          clearInterval(intervalId);
          intervalId = null;
        }

      }
    });
  }
})();
  </script>
</Layout>
