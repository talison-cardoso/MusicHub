---
import Layout from '@/layouts/Layout.astro';
import tracksData from '../data/tracks.json';
---

<Layout>
  <section class="relative w-full overflow-hidden px-6 lg:px-12 pt-36 pb-16">
    <!-- Top Ambient Accent -->
    <div
      class="absolute -top-16 left-1/4 w-96 h-96 bg-primary-container/15 rounded-full blur-[140px] pointer-events-none -z-10"
    >
    </div>
    <div
      class="absolute top-48 right-10 w-80 h-80 bg-secondary-container/20 rounded-full blur-[120px] pointer-events-none -z-10"
    >
    </div>
    <!-- Hero Card Profile & High-Value Metrics (Redesign of Top Section) -->
    <section
      class="w-full bg-surface-container rounded-xl p-6 lg:p-10 shadow-xl relative overflow-hidden mb-10"
    >
      <!-- Subtle top subtle sheen -->
      <div
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"
      >
      </div>
      <div
        class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-8"
      >
        <!-- Artist Identity Column -->
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center gap-6"
        >
          <div class="relative group">
            <div
              class="w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden shadow-2xl relative bg-surface-container-lowest p-1"
            >
              <img
                class="w-full h-full object-cover rounded-full group-hover:scale-105 transition-transform duration-500"
                data-alt="Editorial portrait album artwork cover of hip-hop and trap music artist Young Nisioo, moody cinematic dark blue neon lights with heartbeat waveform pulse graphic and gothic lettering titled Crushes And Lovers EP, 8k resolution, minimalist album sleeve aesthetic"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmBIkZLC9Sx0ZjQpI9NYZgXWfycJ9ehR7vJvvblbpS1DTrhE9WUzp0nvpWZK3RsEi6HHpgaCaLDyznnmMmzpGR322kzh7_GPexea0NPYsZnbQOFstpfJQU2bSuFQNQK-_24yY2yggDcpfE-4jSYYcbU-8spkHDS3OSHXNWCw2iN98wA83UnxBHm0i93erP9Q_0UANwTe0bq8QUtdA_Ji9UZM6tZU97epk9pryyt_zKhJYS_T8YvSZ0"
              />
            </div>
            <div
              class="absolute bottom-1 right-1 w-6 h-6 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-md"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 24 24"
                ><title>baseline-verified</title><path
                  fill="currentColor"
                  d="m23 12l-2.44-2.79l.34-3.69l-3.61-.82l-1.89-3.2L12 2.96L8.6 1.5L6.71 4.69L3.1 5.5l.34 3.7L1 12l2.44 2.79l-.34 3.7l3.61.82L8.6 22.5l3.4-1.47l3.4 1.46l1.89-3.19l3.61-.82l-.34-3.69zm-12.91 4.72l-3.8-3.81l1.48-1.48l2.32 2.33l5.85-5.87l1.48 1.48z"
                ></path></svg
              >
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="font-display-hero text-headline-lg lg:text-headline-lg text-on-surface tracking-tight"
              >
                Young Nisioo
              </span>
              <span
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary font-label-md text-label-md tracking-wide"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
                ></span>
                Rapper &amp; Compositor
              </span>
            </div>
            <p
              class="font-body-md text-body-md text-on-surface-variant max-w-md"
            >
              Música independente com identidade lírica crua, fusão melódica de
              R&amp;B contemporâneo e trap conceitual.
            </p>
            <div class="flex items-center gap-3 pt-2">
              <a
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary-container font-label-lg text-label-lg hover:bg-secondary-container transition-all duration-200 shadow-md"
                data-path="musicas"
                href="#"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="1em"
                  height="1em"
                  viewBox="0 0 24 24"
                  ><title>play-circle-outline</title><path
                    fill="currentColor"
                    d="m9.5 16.5l7-4.5l-7-4.5zM12 22q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22m0-2q3.35 0 5.675-2.325T20 12t-2.325-5.675T12 4T6.325 6.325T4 12t2.325 5.675T12 20m0-8"
                  ></path></svg
                >
                Ouvir Lançamentos
              </a>
              <!-- <a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors font-label-lg text-label-lg shadow-sm" data-path="redes-sociais" href="#">
<span class="material-symbols-outlined text-[18px]">hub</span>
                Conectar
              </a> -->
            </div>
          </div>
        </div>

        <!-- Metric Cards Bento Grid (Matching image's +59 Músicas, +6 EPs, +99 Ouvintes) -->
        <div class="grid grid-cols-3 gap-3 w-full lg:w-auto">
          {
            [
              { value: '+59', label: 'Músicas' },
              { value: '+6', label: 'EPs' },
              { value: '+99K', label: 'Ouvintes' },
            ].map((metric) => (
              <div class="flex flex-col items-center justify-center p-4 sm:p-5 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-all duration-300 text-center shadow-md min-w-[100px]">
                <span class="font-stat-counter text-stat-counter text-secondary tracking-tight">
                  {metric.value}
                </span>
                <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mt-1">
                  {metric.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <!-- Main Content Dual-Column Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Editorial Column: "Sobre o Artista" (From Reference Screen) -->
      <section
        class="lg:col-span-7 flex flex-col gap-6 bg-surface-container rounded-xl p-8 lg:p-10 shadow-xl relative"
      >
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <svg
              class="size-5"
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              ><title>info-circle-outline</title><path
                fill="currentColor"
                d="M11 9h2V7h-2m1 13c-4.41 0-8-3.59-8-8s3.59-8 8-8s8 3.59 8 8s-3.59 8-8 8m0-18A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2m-1 15h2v-6h-2z"
              ></path></svg
            >
            <h2
              class="font-headline-lg text-headline-lg text-on-surface tracking-tight"
            >
              Sobre o Artista
            </h2>
          </div>
          <span
            class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant bg-surface-container-low px-3 py-1 rounded-full"
          >
            Manifesto
          </span>
        </div>
        <!-- Pull quote banner for high-end hip hop editorial feeling -->
        <blockquote
          class="p-4 rounded-lg bg-surface-container-low text-primary font-headline-sm text-headline-sm italic"
        >
          “Mais do que um site de downloads, este é um ponto de encontro entre o
          artista e os seus ouvintes.”
        </blockquote>
        <div
          class="flex flex-col gap-4 font-body-lg text-body-lg text-on-surface-variant leading-relaxed"
        >
          <p>
            Bem-vindo ao espaço oficial de música do rapper e compositor <strong
              class="text-on-surface font-semibold">Young Nisioo</strong
            >, plataforma criada especialmente para aproximar o artista dos seus
            ouvintes e tornar a sua música acessível a todos.
          </p>
          <p>
            Aqui poderás encontrar e fazer download das músicas mais recentes e
            dos projectos já lançados, tudo organizado de forma simples, rápida
            e segura. Cada lançamento é disponibilizado directamente pelo
            artista, garantindo autenticidade e qualidade cristalina.
          </p>
          <p>
            Para além de fazeres download das faixas, esta plataforma permite
            que conheças as redes sociais do Young Nisioo, acompanhes as
            novidades em primeira mão, fiques por dentro dos próximos
            lançamentos e estejas sempre conectado à sua jornada artística.
          </p>
        </div>
        <div
          class="pt-4 flex flex-wrap items-center justify-between gap-4 bg-surface-container-low p-5 rounded-lg"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 24 24"
                ><title>equalizer</title><path
                  fill="currentColor"
                  d="M5 19v-5.808h3V19zm5.5 0V5h3v14zm5.5 0V9.808h3V19z"
                ></path></svg
              >
            </div>
            <div>
              <p class="font-label-lg text-label-lg text-on-surface">
                Explora. Baixa. Partilha.
              </p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">
                Faz parte do movimento cultural Young Nisioo.
              </p>
            </div>
          </div>
          <a
            class="inline-flex items-center gap-1.5 text-primary hover:text-on-surface font-label-lg text-label-lg transition-colors"
            data-path="redes-sociais"
            href="#"
          >
            Ver todas as redes
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              ><title>outline-arrow-forward</title><path
                fill="currentColor"
                d="m12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
              ></path></svg
            >
          </a>
        </div>
      </section>
      <!-- Right Column: Featured Release Spotlight & Interactive Preview -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Featured Release Card -->
        <section
          class="bg-surface-container rounded-xl p-6 lg:p-7 shadow-xl flex flex-col gap-5 relative overflow-hidden"
        >
          <div class="flex items-center justify-between">
            <span
              class="font-label-md text-label-md text-tertiary uppercase tracking-widest flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-tertiary"></span>
              Lançamento em Destaquev
            </span>
            <span class="font-label-md text-label-md text-on-surface-variant"
              >EP Oficial</span
            >
          </div>
          <!-- Album Art with Play Overlay -->
          <div
            class="relative w-full aspect-square rounded-lg overflow-hidden bg-surface-container-low group shadow-lg"
          >
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              data-alt="Modern dark rap music album cover with typography Crushes And Lovers EP by Young Nisioo, artistic monochromatic heart beat line glowing in cyan and deep electric blue, minimal moody urban style, studio cover photograph"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAwgfyNfTljKm6ls8Bc6bKNtn0yOV8dYfbtZDE-nuRjc5hFa7pkXV2dcz_zmfOn_e5J7BgyvHndhJiZiJn1cHOkthtsA_p-9tKOebbk0PBxKLBu_bfdPOtJYmkQdPd7sFs_6sb6dMCFtoNfJunaIx29KL8lgEjmNefNCcIrnDb_YsRRowjN98Mb-nu3HeDtOHMllqnjTvyK-1DtkO6ykVwjJ2p-we8NSAJ16xtiCMo9nCLDz5SYZG5G"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 right-4 flex items-end justify-between"
            >
              <div>
                <span
                  class="font-label-md text-label-md text-secondary-fixed-dim"
                  >Young Nisioo</span
                >
                <h3
                  class="font-headline-lg text-headline-lg text-on-surface tracking-tight leading-none"
                >
                  Crushes And Lovers
                </h3>
              </div>
              <button
                aria-label="Reproduzir prévia de Crushes And Lovers"
                class="w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all"
                id="play-featured-btn"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="1em"
                  height="1em"
                  viewBox="0 0 24 24"
                  ><title>play-arrow-outline</title><path
                    fill="currentColor"
                    d="M8 19V5l11 7zm2-3.65L15.25 12L10 8.65z"></path></svg
                >
              </button>
            </div>
          </div>
          <!-- Track Info / Soundwave Preview Strip -->
          <div
            class="flex flex-col gap-3 bg-surface-container-low p-4 rounded-lg"
          >
            <div
              class="flex items-center justify-between font-label-md text-label-md"
            >
              <span class="text-on-surface">Faixa 01 • Intro (Pre-Save)</span>
              <span class="text-on-surface-variant" id="track-time">02:44</span>
            </div>
            <!-- Dynamic Soundwave SVG Visualization -->
            <div
              class="w-full h-8 flex items-center justify-between gap-1 cursor-pointer"
              id="soundwave-bar"
            >
              <span
                class="w-1 bg-primary/40 rounded-full h-2 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/70 rounded-full h-4 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-6 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-5 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/50 rounded-full h-3 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/90 rounded-full h-7 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-8 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/60 rounded-full h-4 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-6 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/80 rounded-full h-5 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/40 rounded-full h-3 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/70 rounded-full h-7 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-8 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/50 rounded-full h-4 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/80 rounded-full h-6 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-7 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/30 rounded-full h-2 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/60 rounded-full h-4 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary rounded-full h-5 transition-all duration-300"
              ></span>
              <span
                class="w-1 bg-primary/40 rounded-full h-3 transition-all duration-300"
              ></span>
            </div>
            <!-- Action Buttons for Download / Stream -->
            <div class="grid grid-cols-2 gap-3 pt-2">
              <a
                class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-full bg-primary-container text-on-primary-container font-label-lg text-label-lg hover:bg-secondary-container transition-colors shadow-sm"
                data-path="ouvir-agora"
                href="#"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="1em"
                  height="1em"
                  viewBox="0 0 24 24"
                  ><title>download</title><path
                    fill="currentColor"
                    d="m12 16l-5-5l1.4-1.45l2.6 2.6V4h2v8.15l2.6-2.6L17 11zm-6 4q-.825 0-1.412-.587T4 18v-3h2v3h12v-3h2v3q0 .825-.587 1.413T18 20z"
                  ></path></svg
                >
                Download MP3
              </a>
              <a
                class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-full bg-surface-container-high text-on-surface font-label-lg text-label-lg hover:bg-surface-bright transition-colors shadow-sm"
                data-path="musicas"
                href="#"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="1em"
                  height="1em"
                  viewBox="0 0 24 24"
                  ><title>library-music-outline</title><path
                    fill="currentColor"
                    d="M12.5 15q1.05 0 1.775-.725T15 12.5V7h3V5h-4v5.5q-.325-.25-.7-.375T12.5 10q-1.05 0-1.775.725T10 12.5t.725 1.775T12.5 15M8 18q-.825 0-1.412-.587T6 16V4q0-.825.588-1.412T8 2h12q.825 0 1.413.588T22 4v12q0 .825-.587 1.413T20 18zm0-2h12V4H8zm-4 6q-.825 0-1.412-.587T2 20V6h2v14h14v2zM8 4v12z"
                  ></path></svg
                >
                Ver Tracklist
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
    <!-- Latest Discography Highlights Grid -->
    <section class="w-full flex flex-col gap-6 pt-4">
      <div class="flex items-center justify-between">
        <div>
          <span
            class="font-label-md text-label-md text-primary uppercase tracking-widest"
            >Catálogo</span
          >
          <h2
            class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1"
          >
            Músicas Recentes para Download
          </h2>
        </div>
        <a
          class="inline-flex items-center gap-2 font-label-lg text-label-lg text-primary hover:text-on-surface transition-colors"
          data-path="musicas"
          href="#"
        >
          Ver todas as 59 faixas
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1em"
            height="1em"
            viewBox="0 0 24 24"
            ><title>chevron-forward</title><path
              fill="currentColor"
              d="M12.6 12L8 7.4L9.4 6l6 6l-6 6L8 16.6z"></path></svg
          >
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          tracksData.map((track) => (
            <div class="bg-surface-container rounded-xl p-5 shadow-xl flex flex-col justify-between gap-5 group hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-start gap-4">
                <div class="w-20 h-20 rounded-lg overflow-hidden bg-surface-container-lowest shrink-0 shadow-md">
                  <img
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    alt={track.alt}
                    src={track.image}
                  />
                </div>
                <div class="flex flex-col min-w-0">
                  <span class="font-label-md text-label-md text-secondary">
                    {track.badge}
                  </span>
                  <h4 class="font-headline-sm text-headline-sm text-on-surface truncate mt-0.5">
                    {track.title}
                  </h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant truncate">
                    {track.artist}
                  </p>
                  <span class="font-label-md text-label-md text-on-surface-variant mt-2">
                    {track.duration}
                  </span>
                </div>
              </div>

              <div class="flex items-center justify-between pt-3 bg-surface-container-low px-4 py-3 rounded-lg">
                <span class="font-label-md text-label-md text-primary">
                  Disponível Grátis
                </span>
                <a
                  class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center hover:bg-secondary-container transition-colors"
                  href="#"
                  aria-label="Baixar"
                >
                  ↓
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>


  </section></Layout
>
