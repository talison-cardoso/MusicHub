---
const pathname = new URL(Astro.request.url).pathname;
const isLogged = !!Astro.locals.user;

const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};

const linkBaseClass =
  'font-label-lg text-label-lg px-4 py-2 rounded-full transition-colors';
const inactiveClass = 'text-on-surface-variant hover:text-on-surface';
const activeClass =
  'bg-primary-container text-on-primary-container font-medium';
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
>
  <div
    class="h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between"
  >
    {/* Logo / Brand */}
    <a class="group flex flex-col" href="/">
      <span
        class="font-headline-md text-headline-md tracking-tight uppercase text-on-surface group-hover:text-primary transition-colors"
      >
        Young Nisioo
      </span>
      <span
        class="font-label-md text-label-md text-on-surface-variant tracking-widest uppercase"
      >
        Official Artist
      </span>
    </a>

    {/* Navegação Principal */}
    <nav
      class="hidden md:flex items-center gap-2 bg-surface-container-low/70 p-1.5 rounded-full shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
    >
      <a
        href="/"
        class={`${linkBaseClass} ${isActive('/') ? activeClass : inactiveClass}`}
      >
        Início
      </a>

      <a
        href="/music"
        class={`${linkBaseClass} ${isActive('/music') ? activeClass : inactiveClass}`}
      >
        Músicas
      </a>

      <a
        href="/socials"
        class={`${linkBaseClass} ${isActive('/socials') ? activeClass : inactiveClass}`}
      >
        Redes Sociais
      </a>

      {
        isLogged && (
          <a
            href="/admin"
            class={`${linkBaseClass} ${isActive('/admin') ? activeClass : inactiveClass}`}
          >
            Admin
          </a>
        )
      }
    </nav>

    {/* Ações / Tema / Perfil */}
    <div class="flex items-center gap-3 sm:gap-4">
      {/* Botão para alternar Tema (Light / Dark) */}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Alternar Tema"
        class="p-2.5 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
      >
        {/* Ícone de Sol (visível no Dark) */}
        <span class="material-symbols-outlined text-[20px] hidden dark:block">
          light_mode
        </span>
        {/* Ícone de Lua (visível no Light) */}
        <span class="material-symbols-outlined text-[20px] block dark:hidden">
          dark_mode
        </span>
      </button>

      <a
        class="hidden sm:inline-flex items-center justify-center font-label-lg text-label-lg bg-primary-container text-on-primary-container hover:bg-secondary-container hover:text-on-surface px-5 py-2.5 rounded-full transition-all duration-200 shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
        href="/music"
      >
        Ouvir Agora
      </a>

      <div
        class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer"
        title={isLogged ? 'Usuário logado' : 'Visitante'}
      >
        <span class="material-symbols-outlined text-on-primary text-[18px]">
          person
        </span>
      </div>
    </div>
  </div>
</header>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle('dark');

    const isDark = element.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  document
    .getElementById('theme-toggle')
    ?.addEventListener('click', handleToggleClick);
</script>
